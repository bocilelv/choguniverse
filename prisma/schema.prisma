generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id               String   @id @default(cuid())
  name             String?
  email            String   @unique
  image            String?
  discordId        String?  @unique
  discordUsername  String?
  twitterId        String?  @unique
  twitterUsername  String?
  evmAddress       String?
  suiAddress       String?
  btcAddress       String?
  injAddress       String?
  createdAt        DateTime @default(now())
  entries          Entry[]
}

model Raffle {
  id                    String   @id @default(cuid())
  title                 String
  description           String?
  image                 String
  blockchain            String   @default("MONAD")
  startDate             DateTime @default(now())
  endDate               DateTime
  totalSpots            Int      @default(100)
  entriesCount          Int      @default(0)
  // requirements: follow up to 3 (1 wajib, 2 optional)
  twitterHandle1        String   @default("chog")
  twitterHandle2        String?
  twitterHandle3        String?
  discordRequired       Boolean  @default(true)
  discordInvite1        String?
  discordInvite2        String?
  likePostUrl           String?  // optional
  rtPostUrl             String?  // optional
  status                String   @default("LIVE")
  createdAt             DateTime @default(now())
  entries               Entry[]
}

model Entry {
  id        String   @id @default(cuid())
  userId    String
  raffleId  String
  createdAt DateTime @default(now())
  isValid   Boolean  @default(true)
  isWinner  Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  raffle    Raffle   @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  @@unique([userId, raffleId])
}
