generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id               String   @id @default(cuid())
  name             String?
  email            String?  @unique
  image            String?
  discordId        String?  @unique
  discordUsername  String?
  twitterId        String?  @unique
  twitterUsername  String?
  createdAt        DateTime @default(now())
  entries          Entry[]
}

model Raffle {
  id                  String   @id @default(cuid())
  title               String
  description         String
  image               String
  endDate             DateTime
  totalSpots          Int
  entriesCount        Int      @default(0)
  twitterFollowRequired Boolean @default(true)
  twitterHandle       String   @default("@chog")
  discordRequired     Boolean  @default(true)
  discordInvite      String   @default("https://discord.gg/chog")
  blockchain          String   @default("MONAD")
  status              String   @default("LIVE")
  createdAt           DateTime @default(now())
  entries             Entry[]
}

model Entry {
  id        String   @id @default(cuid())
  userId    String
  raffleId  String
  createdAt DateTime @default(now())
  isValid   Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id])
  raffle    Raffle   @relation(fields: [raffleId], references: [id])

  @@unique([userId, raffleId])
}
